{
  "name": "api.ttcstatus.ca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:api",
    "build:api": "npm run typecheck && npm run build:ui && npm run build:viewer",
    "build:map": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "map:preview": "node scripts/preview-map.mjs",
    "build:viewer": "node scripts/build-viewer.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "dev:api": "npm run build:ui && npm run build:viewer && wrangler dev -c workers/api/wrangler.jsonc",
    "dev:viewer": "vite",
    "dev:map": "wrangler dev -c workers/map-generator/wrangler.jsonc",
    "deploy:api": "wrangler deploy -c workers/api/wrangler.jsonc",
    "deploy:map": "wrangler deploy -c workers/map-generator/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply ttcstatus --local -c workers/api/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply ttcstatus --remote -c workers/api/wrangler.jsonc",
    "build:ui": "vite build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build",
    "test:ui": "node scripts/check-ui.mjs",
    "test:auth": "node scripts/check-auth.mjs",
    "test:mobile": "node scripts/check-mobile.mjs",
    "test:hackathon": "node scripts/check-hackathon.mjs",
    "test:exploration": "node scripts/check-exploration.mjs",
    "test:collection": "node scripts/check-collection.mjs",
    "test:stories": "node scripts/check-stories.mjs",
    "map:regenerate:remote": "node scripts/regenerate-map.mjs"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.2",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.22.0",
    "@clerk/react": "^6.17.5",
    "gtfs-realtime-bindings": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
