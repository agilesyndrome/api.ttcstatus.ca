{
  "name": "api.ttcstatus.ca",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilesyndrome/api.ttcstatus.ca.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "node scripts/hooks/install.mjs",
    "build": "npm run build:api",
    "build:api": "npm run build:ui && npm run build:viewer",
    "build:map": "npm run typecheck",
    "pre-flight": "node ./pre-flight",
    "ci": "npm run pre-flight && npm run build:storybook && npm run deploy:api:dry && npm run deploy:map:dry",
    "deploy:api:dry": "wrangler deploy --dry-run -c workers/api/wrangler.jsonc",
    "deploy:map:dry": "wrangler deploy --dry-run -c workers/map-generator/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "map:depot": "node scripts/preview/depot-board.mjs",
    "build:viewer": "node scripts/build/build-viewer.mjs",
    "test": "node --test --test-isolation=none tests/*/*.test.mjs",
    "dev:api": "npm run build:ui && npm run build:viewer && wrangler dev -c workers/api/wrangler.jsonc --port 8787 --test-scheduled",
    "dev:viewer": "vite",
    "dev:map": "wrangler dev -c workers/map-generator/wrangler.jsonc --port 8788",
    "deploy:api": "npm run db:migrate:remote && wrangler deploy -c workers/api/wrangler.jsonc --keep-vars",
    "deploy:map": "npm run db:migrate:remote && wrangler deploy -c workers/map-generator/wrangler.jsonc --keep-vars",
    "secrets:sync": "op run --env-file=.env.${ENV} -- node scripts/operations/sync-cloudflare-secrets.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ttcstatus --local -c workers/api/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply ttcstatus --remote -c workers/api/wrangler.jsonc",
    "build:ui": "vite build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build",
    "test:ui": "node scripts/checks/check-ui.mjs",
    "test:auth": "node scripts/checks/check-auth.mjs",
    "test:mobile": "node scripts/checks/check-mobile.mjs",
    "test:hackathon": "node scripts/checks/check-hackathon.mjs",
    "test:exploration": "node scripts/checks/check-exploration.mjs",
    "test:collection": "node scripts/checks/check-collection.mjs",
    "test:stories": "node scripts/checks/check-stories.mjs",
    "map:regenerate:remote": "node scripts/operations/regenerate-map.mjs",
    "map:regenerate:local": "node scripts/operations/regenerate-map.mjs --local",
    "map:tag": "node scripts/operations/tag-map.mjs",
    "test:snake": "node scripts/checks/check-snake.mjs",
    "test:snake:intersections": "node scripts/checks/check-snake-intersections.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "node ./pre-flight check",
    "check:secrets": "node ./pre-flight check secrets",
    "check:boundaries": "node scripts/checks/check-boundaries.mjs",
    "map:import": "node scripts/preview/import-rail-map.mjs",
    "test:subway": "node scripts/checks/check-subway.mjs",
    "test:i18n": "node scripts/checks/check-i18n.mjs"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "eslint": "10.12.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "storybook": "^10.6.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.2",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.22.0",
    "@clerk/localizations": "^4.21.2",
    "@clerk/react": "^6.17.5",
    "gtfs-realtime-bindings": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
