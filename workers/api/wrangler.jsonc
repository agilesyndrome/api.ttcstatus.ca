{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ttcstatus-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "previews": {},
  "assets": {
    "directory": "../../dist",
    // `/__scheduled` serves wrangler dev's --test-scheduled cron trigger; the
    // worker owns it so the SPA fallback cannot swallow it (in production the
    // router simply 404s the path — no page lives there).
    "run_worker_first": ["/api/*", "/lite*", "/__scheduled"],
    "not_found_handling": "single-page-application",
  },
  "limits": {
    "cpu_ms": 300000,
  },
  // Keep sanitized application logs; automatic invocation logs include raw URLs.
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true,
    },
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "ttcstatus_metrics",
    },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": {
    // The nightly static GTFS sync (map + SLA schedule targets), plus the
    // hourly SLA rollup (Epic 8, E8S3) that folds completed Toronto days
    // into the daily/weekly SLA tables before 36-hour retention prunes them.
    "crons": ["17 7 * * *", "41 * * * *"],
  },
  "vars": {
    "CLERK_AUTHORIZED_PARTIES": "https://ttcstatus.ca,capacitor://localhost",
    // Live refresh and shared snapshot cache lifetime, in seconds (30–300).
    "REALTIME_SUBWAY_URL": "https://gtfsrt.ttc.ca/trips/subway?format=binary",
    "REALTIME_UPDATE_SECONDS": "30",
    "REALTIME_VEHICLE_URL": "https://bustime.ttc.ca/gtfsrt/vehicles",
    // Live transport discovery (optimize-transport.md change 1b): served
    // verbatim from `/api/v1/auth/config` (`public, max-age=300`) so no
    // client or shipped binary bakes a live host, cadence, or path.
    "LIVE_PUBLIC_BASE": "https://live.ttcstatus.ca",
    "LIVE_PATH_TEMPLATE": "/live/t/{tick}/vehicles.json",
    "LIVE_UPDATE_SECONDS": "30",
    // Void-overlay transport + the public rollout switch
    // (docs/optimize-overlay.md E1S4, flipped at E6S4). The overlay is ON for
    // every visitor — signed-out included: the recorder publishes
    // `live/t/<tick>/service-stops.json` unconditionally, the CDN serves the
    // bytes, and this var (deployed with this revision) is the only gate.
    // Set to "false" to rehearse the off state.
    "OVERLAY_ENABLED": "true",
    "LIVE_SERVICE_PATH_TEMPLATE": "/live/t/{tick}/service-stops.json",
    "OVERLAY_POLL_SECONDS": "30",
    "STATIC_GTFS_URL": "https://ckan0.cf.opendata.inter.prod-toronto.ca/dataset/b811ead4-6eaf-4adb-8408-d389fb5a069c/resource/c920e221-7a1c-488b-8c5b-6d8cd4e85eaf/download/completegtfs.zip",
    "SOURCE_ATTRIBUTION": "Contains information licensed under the Open Government Licence - Toronto",
    "NO_VALIDATOR_REFETCH_DAYS": "7",
    // SLA delivered-service recorder (docs/sla.md §4; validated defaults in
    // shared/service/config.ts — these overrides mirror the Stage 0 decisions).
    "SERVICE_SAMPLE_SECONDS": "30",
    "SERVICE_TICK_TOLERANCE_SECONDS": "10",
    "SERVICE_TOUCH_RADIUS_METRES": "40",
    "SERVICE_DWELL_DEDUPE_SECONDS": "120",
    "SERVICE_BACK_TO_BACK_SECONDS": "45",
    "SERVICE_FRESH_DRYNESS_RATIO": "0.5",
    "SERVICE_VOID_DRYNESS_RATIO": "2",
    "SERVICE_VOID_ABSOLUTE_MINUTES": "15",
    "SERVICE_HISTORY_HOURS": "36",
    "SERVICE_BASELINE_MIN_TOUCHES": "3",
    "SERVICE_RESIDUAL_MIN_SAMPLES": "3",
    "SERVICE_WAIT_SHRINK_PRIOR": "4",
    "SERVICE_RECORDER_MODE": "always",
    // Promise lens (Epic 8; validated defaults in shared/service/config.ts).
    "SLA_TOLERANCE_RATIO": "1.5",
    "SLA_MET_RATIO": "0.9",
    "SLA_DEGRADED_RATIO": "0.7",
  },
  // The recorder singleton (sla.md §4.4): 30 s alarms, DO SQL window store.
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVICE_RECORDER",
        "class_name": "ServiceRecorder",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-service-recorder",
      "new_sqlite_classes": ["ServiceRecorder"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ttcstatus",
      "database_id": "7c7e47b4-da33-42de-a521-df30b79e41f2",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "GTFS_BUCKET",
      "bucket_name": "ttcstatus-static-gtfs",
    },
    // Dedicated PUBLIC live bucket (optimize-transport.md change 1): one
    // immutable tick document per 30 s tick at `live/t/<tickId>/vehicles.json`.
    // Never the GTFS archive bucket — this one is world-readable by design.
    // Dashboard steps (one-time operator runbook, in
    // docs/optimize-transport-thunks.md):
    //  1. Attach R2 custom domain `live.ttcstatus.ca`.
    //  2. Cache rule: host eligible, edge TTL ≥ object `max-age=600`.
    //  3. Transform Rule: `Access-Control-Allow-Origin: *` on this host.
    //  4. Lifecycle rule: expire `live/t/` objects after 7 days (confirmed
    //     2026-10-13 — one prefix rule covers vehicles + service-stops).
    {
      "binding": "LIVE_BUCKET",
      "bucket_name": "ttcstatus-live",
    },
  ],
  // No MAP_GENERATOR service binding (docs/optimize-transport.md Epic 7):
  // the generator core lives in src/mapgen/ and runs in-process — one worker,
  // one deploy artifact, one config. Nothing provisions a second worker.
  "services": [],
}
