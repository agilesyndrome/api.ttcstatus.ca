{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ttcstatus-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "previews": {},
  "assets": {
    "directory": "../../dist",
    // `/__scheduled` serves wrangler dev's --test-scheduled cron trigger; the
    // worker owns it so the SPA fallback cannot swallow it (in production the
    // router simply 404s the path — no page lives there).
    "run_worker_first": ["/api/*", "/__scheduled"],
    "not_found_handling": "single-page-application",
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "observability": { "enabled": true },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "ttcstatus_metrics",
    },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": {
    // The nightly static GTFS sync (map + SLA schedule targets), plus the
    // hourly SLA rollup (Epic 8, E8S3) that folds completed Toronto days
    // into the daily/weekly SLA tables before 36-hour retention prunes them.
    "crons": ["17 7 * * *", "41 * * * *"],
  },
  "vars": {
    "CLERK_AUTHORIZED_PARTIES": "https://ttcstatus.ca",
    // Live refresh and shared snapshot cache lifetime, in seconds (30–300).
    "REALTIME_SUBWAY_URL": "https://gtfsrt.ttc.ca/trips/subway?format=binary",
    "REALTIME_UPDATE_SECONDS": "30",
    "REALTIME_VEHICLE_URL": "https://bustime.ttc.ca/gtfsrt/vehicles",
    "STATIC_GTFS_URL": "https://ckan0.cf.opendata.inter.prod-toronto.ca/dataset/b811ead4-6eaf-4adb-8408-d389fb5a069c/resource/c920e221-7a1c-488b-8c5b-6d8cd4e85eaf/download/completegtfs.zip",
    "SOURCE_ATTRIBUTION": "Contains information licensed under the Open Government Licence - Toronto",
    "NO_VALIDATOR_REFETCH_DAYS": "7",
    // SLA delivered-service recorder (docs/sla.md §4; validated defaults in
    // shared/service/config.ts — these overrides mirror the Stage 0 decisions).
    "SERVICE_SAMPLE_SECONDS": "30",
    "SERVICE_TICK_TOLERANCE_SECONDS": "10",
    "SERVICE_TOUCH_RADIUS_METRES": "40",
    "SERVICE_DWELL_DEDUPE_SECONDS": "120",
    "SERVICE_BACK_TO_BACK_SECONDS": "45",
    "SERVICE_FRESH_DRYNESS_RATIO": "0.5",
    "SERVICE_VOID_DRYNESS_RATIO": "2",
    "SERVICE_VOID_ABSOLUTE_MINUTES": "15",
    "SERVICE_HISTORY_HOURS": "36",
    "SERVICE_BASELINE_MIN_TOUCHES": "3",
    "SERVICE_RESIDUAL_MIN_SAMPLES": "3",
    "SERVICE_WAIT_SHRINK_PRIOR": "4",
    "SERVICE_RECORDER_MODE": "always",
    // Promise lens (Epic 8; validated defaults in shared/service/config.ts).
    "SLA_TOLERANCE_RATIO": "1.5",
    "SLA_MET_RATIO": "0.9",
    "SLA_DEGRADED_RATIO": "0.7",
  },
  // The recorder singleton (sla.md §4.4): 30 s alarms, DO SQL window store.
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVICE_RECORDER",
        "class_name": "ServiceRecorder",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-service-recorder",
      "new_sqlite_classes": ["ServiceRecorder"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ttcstatus",
      "database_id": "7c7e47b4-da33-42de-a521-df30b79e41f2",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "GTFS_BUCKET",
      "bucket_name": "ttcstatus-static-gtfs",
    },
  ],
  "services": [
    {
      "binding": "MAP_GENERATOR",
      "service": "ttcstatus-map-generator",
    },
  ],
}
