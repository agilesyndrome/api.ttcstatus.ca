{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "esModuleInterop": true
  },
  "include": [
    "shared/**/*.ts",
    "workers/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    ".storybook/**/*.ts"
  ]
}
