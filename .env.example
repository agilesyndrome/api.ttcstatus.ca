# Copy to .env.local and fill in. Values may be literals (shown here) or
# 1Password `op://…` references — the dev commands resolve the latter through
# the 1Password CLI when it is unlocked (see docs/clerk-setup.md). Everything
# except the Clerk keys is optional for local development.
CLOUDFLARE_INCLUDE_PROCESS_ENV=true

# Authentication (development instance keys, never production keys).
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_JWKS_URL=https://YOUR_CLERK_FRONTEND_API/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8787,http://localhost:8787,capacitor://localhost

# Local admin credential. Never commit a real token.
SYNC_TOKEN=REPLACE_WITH_A_NEW_RANDOM_TOKEN
