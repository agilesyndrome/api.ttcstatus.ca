#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: bin/api METHOD ENDPOINT [curl options...]

Examples:
  bin/api GET /api/v1/map/streetcar
  bin/api GET /api/v1/feed/status
  bin/api POST /api/v1/admin/sync

Set API_HOST to override https://api.ttcstatus.ca.
SYNC_TOKEN is required for /api/v1/admin/* endpoints.
EOF
}

if [[ $# -lt 2 ]]; then
  usage
  exit 2
fi

method=$1
endpoint=$2
shift 2

api_host=${API_HOST:-https://api.ttcstatus.ca}
api_host=${api_host%/}

if [[ $endpoint == http://* || $endpoint == https://* ]]; then
  url=$endpoint
else
  [[ $endpoint == /* ]] || endpoint="/$endpoint"
  url="$api_host$endpoint"
fi

curl_args=(--request "$method" --silent)

if [[ $endpoint == /api/v1/admin/* ]]; then
  if [[ -z ${SYNC_TOKEN:-} ]]; then
    echo "SYNC_TOKEN must be set for admin endpoints" >&2
    exit 1
  fi
  curl_args+=(--header "Authorization: Bearer $SYNC_TOKEN")
fi

curl "${curl_args[@]}" "$url" "$@"
