# Hardening applied to every static response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Enforced site-wide. The Clerk frontend-api origin (clerk.ttcstatus.ca) is
  # decoded from the pk_live_ key; see docs/security.md. worker-src allows the
  # bundled board worker ('self') and Clerk's blob-based timer workers (blob:),
  # which otherwise fall back to script-src and get blocked.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://clerk.ttcstatus.ca; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.clerk.com; font-src 'self' data:; connect-src 'self' https://clerk.ttcstatus.ca; frame-src 'self' https://clerk.ttcstatus.ca; form-action 'self' https://clerk.ttcstatus.ca; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# The classic snake game is fully self-contained: no Clerk, no remote fetches.
# Its policy is enforced today.
/snake/v1/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'